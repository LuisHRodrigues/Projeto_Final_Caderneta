# Copie para .env (ignorado pelo git) e preencha. Não há senha padrão: o compose não sobe sem elas.
# Use senhas novas e fortes. NUNCA reutilize senhas que já apareceram no histórico do Git.
# Gerar uma senha:  openssl rand -base64 24

# --- Banco (três senhas DIFERENTES) --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
# usuário caderneta_app (API, só leitura/escrita de dados)
CADERNETA_DB_PASSWORD=
# usuário caderneta_migracao (Flyway, altera o esquema)
CADERNETA_MIGRATION_PASSWORD=
# As senhas são aplicadas ao criar o volume do MySQL. Para trocá-las depois, rode
# backend-repo/scripts/criar-usuarios-mysql.sh (ver docs/operacao-local.md).

# --- Teste LOCAL em HTTP -------------------------------------------------------------------------
# Vazio (padrão) = perfil seguro: cookie "Secure" (exige HTTPS). Para http://localhost:3000, use:
# SPRING_PROFILES_ACTIVE=dev
# Dados fictícios de desenvolvimento (NUNCA em servidor real):
# CADERNETA_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev

# --- Primeiro gerente (criado só se ainda não houver gerente ativo) ------------------------------
# Preencha, suba uma vez e depois apague estas linhas.
CADERNETA_BOOTSTRAP_LOGIN=
CADERNETA_BOOTSTRAP_SENHA=
CADERNETA_BOOTSTRAP_NOME=Gerente
CADERNETA_BOOTSTRAP_CPF=
