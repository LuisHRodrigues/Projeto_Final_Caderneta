# Copie para .env (ignorado pelo git) e ajuste. Não há senha padrão de usuário.

# --- Teste LOCAL em HTTP -------------------------------------------------------------------------
# Vazio (padrão) = perfil seguro: cookie "Secure" (exige HTTPS) e sem dados fictícios.
# Para testar em http://localhost:3000 com contas fictícias, use as duas linhas abaixo.
# NUNCA use isto em um servidor real.
# SPRING_PROFILES_ACTIVE=dev,dev-fixtures

# --- Primeiro gerente (criado só se ainda não houver gerente ativo) ------------------------------
CADERNETA_BOOTSTRAP_LOGIN=
CADERNETA_BOOTSTRAP_SENHA=
CADERNETA_BOOTSTRAP_NOME=Gerente
CADERNETA_BOOTSTRAP_CPF=

# --- Banco ---------------------------------------------------------------------------------------
# Troque em qualquer ambiente real. (Se mudar depois de o volume existir, altere também no MySQL.)
# MYSQL_ROOT_PASSWORD=
