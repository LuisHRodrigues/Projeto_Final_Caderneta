# Ambiente local. Gere segredos alfanuméricos com pelo menos 32 caracteres.
MYSQL_IMAGE=mysql:8.0.46
MYSQL_ROOT_PASSWORD=
CADERNETA_DB_PASSWORD=
CADERNETA_MIGRATION_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
# Apenas para a primeira instalação, sem gerente ativo.
CADERNETA_BOOTSTRAP_LOGIN=
CADERNETA_BOOTSTRAP_SENHA=
CADERNETA_BOOTSTRAP_CPF=
# Produção usa SPRING_PROFILES_ACTIVE=production e docker-compose.producao.yml.
# TLS_CERT_DIR contém fullchain.pem e privkey.pem.
